<?xml version="1.0" encoding="UTF-8"?>
<launch4jConfig>
    <headerType>gui</headerType>
    <outfile>/workspace/InternetCafeSystem/InternetCafeSystem.exe</outfile>
    <jar>/workspace/InternetCafeSystem/InternetCafeSystem.jar</jar>
    <dontWrapJar>false</dontWrapJar>
    
    <errTitle>网吧计费管理系统 - 启动错误</errTitle>
    <chdir>.</chdir>
    <stayAlive>false</stayAlive>
    
    <jre>
        <path>jre;%JAVA_HOME%;%PATH%</path>
        <bundledJre64Bit>true</bundledJre64Bit>
        <bundledJreAsFallback>true</bundledJreAsFallback>
        <minVersion>1.8.0</minVersion>
        <maxVersion></maxVersion>
        <jdkPreference>preferJre</jdkPreference>
        <runtimeBits>64/32</runtimeBits>
        <initialHeapSize>64</initialHeapSize>
        <maxHeapSize>512</maxHeapSize>
        <opt>-Dfile.encoding=UTF-8</opt>
        <opt>-Dsun.java2d.d3d=false</opt>
    </jre>
    
    <versionInfo>
        <fileVersion>1.0.0.0</fileVersion>
        <txtFileVersion>1.0.0</txtFileVersion>
        <fileDescription>网吧计费管理系统</fileDescription>
        <copyright>InternetCafeSystem 2026</copyright>
        <productVersion>1.0.0.0</productVersion>
        <txtProductVersion>1.0.0</txtProductVersion>
        <productName>网吧计费管理系统</productName>
        <companyName>InternetCafeSystem</companyName>
        <internalName>InternetCafeSystem</internalName>
        <originalFilename>InternetCafeSystem.exe</originalFilename>
    </versionInfo>
</launch4jConfig>